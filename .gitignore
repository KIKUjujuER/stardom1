# Autotools.gitignore from https://github.com/github/gitignore/

# http://www.gnu.org/software/automake

Makefile.in

# http://www.gnu.org/software/autoconf

/autom4te.cache
/aclocal.m4
/compile
/configure
/depcomp
/install-sh
/missing
/stamp-h1
/ar-lib

# End of template. Additional autoconf and automake files follow.

Makefile
/config.guess
/config.h
/config.h.in
/config.log
/config.status
/config.sub
.deps
/a.out
/a.out.js
/a.wasm

# Compiled files

*.o
*.a
*.map
/src/dosbox
/src/dosbox.exe
/src/dosbox.js
/src/dosbox.html
/src/dosbox.html.mem
/src/dosbox.js.orig.js
/src/dosbox.js.tmp.js
/src/dosbox.asm.js
/src/dosbox.wasm
/src/dosbox.wast

# Miscellaneous files

*~
/include/version.h

# NTFS alternate-data-stream markers left behind by browser downloads
:*:Zone.Identifier

# --- whereq-dosbox additions (native baseline + Android port) ---

# rootless dev toolchain (downloaded .deb files + extracted sysroot)
/toolchain/pkgs/
/toolchain/sysroot/

# out-of-tree native/autotools build
/build/

# benchmark scratch dirs
/bench/run/
/bench/rt/

# the object file and the .COM of the example game bundle.
# The bundle zip in examples/game-bundle/dist/ IS committed, so that the
# example can be installed on a phone without building anything.
/examples/game-bundle/build/

# the same for the OPL save-state test bundle.
/examples/opl-test-bundle/build/

# Android build outputs
/android/.cxx/
/android/build/
/android/app/build/
/android/local.properties
/android/.gradle/
/android/.kotlin/

# Signing material - never commit these
/android/keystore.properties
*.keystore
*.jks

# The published APKs live in the GitHub releases, not in the repository: CI
# builds them from the release tag and publishes them there. A local build
# dropped into downloads/ is build output - do not commit it.
/downloads/*.apk
/downloads/*.apk.sha256

# Python bytecode
__pycache__/
*.pyc

# third-party sources: fetched by third_party/fetch-sdl2.sh, not committed
/third_party/SDL2-*/
/third_party/*.tar.gz

# Native libraries staged for the Gradle build by android/build-android.sh.
# They are build output, not source - regenerate them with that script.
/android/app/src/main/jniLibs/

# Raw device and build logs captured while porting. The findings that matter
# are written up in docs/TECHNICAL-REFERENCE.md; the raw logs stay local.
/docs/logs/
